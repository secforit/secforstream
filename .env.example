# ─── SECforSTREAM Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in your values

# JWT secret for auth tokens (change in production!)
JWT_SECRET=dev-secret-change-in-production

# Solana RPC URL
SOLANA_RPC_URL=https://api.devnet.solana.com

# $SECS Token Mint Address
TOKEN_MINT=7aS4v65fEGvQseGxmrZ8iGNpHW7yd49SMmLm2cLApump

# Upstash Redis (optional - falls back to in-memory if not set)
# Get free at https://upstash.com
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# Helius RPC (free tier: 1M credits/month)
# Sign up at https://www.helius.dev/
HELIUS_API_KEY=your-helius-api-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key

# Token configuration
NEXT_PUBLIC_TOKEN_ADDRESS=7aS4v65fEGvQseGxmrZ8iGNpHW7yd49SMmLm2cLApump
NEXT_PUBLIC_TOKEN_SYMBOL=SECS

# PumpPortal WebSocket (no auth needed)
NEXT_PUBLIC_PUMP_WS_URL=wss://pumpportal.fun/api/data
